__pycache__/
*.pyc
.DS_Store
pipeline/fonts/*.otf
pipeline/fonts/*.ttf

# Book artifacts. This repo gets vendored or symlinked into a book vault,
# so a stray `git add -A` from the wrong directory must not be able to
# commit a manuscript, a cover or a press-ready file.
*.pdf
*.epub
*.mobi
*.azw3
*.indd
*.psd
*.ai
*.png
*.jpg
*.jpeg
*.tif
*.tiff
/Deliver/
/Publishing/
/Production/
/Story/
/Strategy/
/images/
/book.yml
_book/
.quarto/
*.qmd

# Demo build output. The examples/ vaults are inputs only -- running them
# writes PDFs, .qmd and skeleton.html next to the source, and none of that
# belongs in the repo.
examples/*/Deliver/
examples/*/manuscript.*
examples/*/interior.*
examples/*/cover.*
examples/*/.quarto/
examples/*/Strategy/creative/skeleton.html
# Quarto drops its own .gitignore into a book folder, and build.py symlinks
# the shared _quarto.yml into any book that lacks one. Both are generated.
# alice-novel's _quarto.yml is the exception: a real file carrying real
# trade-fiction typesetting, which is the point of that demo.
examples/*/.gitignore
examples/*/_quarto.yml
!examples/alice-novel/_quarto.yml
